{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/rooms",              "destination": "/api/rooms.js" },
    { "source": "/api/schedule",           "destination": "/api/schedule.js" },
    { "source": "/api/admin/login",        "destination": "/api/admin/login.js" },
    { "source": "/api/admin/schedule",     "destination": "/api/admin/schedule.js" }
  ]
}
